{
  "name": "reminderz",
  "author": "Organik Apps",
  "version": "1.1.0",
  "description": "Apple Reminders on Pebble",
  "keywords": ["pebble-app"],
  "license": "MIT",
  "repository": "GeezusChrotch/reminderz",
  "homepage": "https://github.com/GeezusChrotch/reminderz",
  "bugs": "https://github.com/GeezusChrotch/reminderz/issues",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "sh scripts/check.sh",
    "build": "pebble build",
    "package": "sh scripts/package.sh",
    "notarize": "sh scripts/notarize-connector.sh"
  },
  "dependencies": {},
  "pebble": {
    "displayName": "Reminderz",
    "uuid": "4222ef0c-1662-4a33-9d09-66779fa7343b",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": ["configurable"],
    "targetPlatforms": ["basalt", "emery"],
    "watchapp": {"watchface": false},
    "messageKeys": {
      "COMMAND": 0,
      "ITEM_KIND": 1,
      "ITEM_INDEX": 2,
      "ITEM_TITLE": 3,
      "ITEM_COUNT": 4,
      "LIST_DONE": 5,
      "ERROR": 6,
      "STATUS": 7,
      "VOICE_TEXT": 8,
      "THEME_BACKGROUND": 9,
      "THEME_TEXT": 10,
      "THEME_SELECTION": 11,
      "THEME_SELECTION_TEXT": 12,
      "THEME_FONT": 13,
      "THEME_SIZE": 14,
      "ITEM_DONE": 15
    },
    "resources": {
      "media": [
